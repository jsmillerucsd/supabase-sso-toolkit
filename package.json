{
  "name": "@ucsd/supabase-sso",
  "version": "1.0.0",
  "description": "Reusable SAML SSO + RLS toolkit for Supabase projects: attribute projection, role derivation, auth hook, and Next.js/SPA client integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsmillerucsd/supabase-sso-toolkit.git"
  },
  "homepage": "https://github.com/jsmillerucsd/supabase-sso-toolkit#readme",
  "bugs": "https://github.com/jsmillerucsd/supabase-sso-toolkit/issues",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:sql && tsup",
    "build:sql": "node scripts/build-install-sql.mjs",
    "typecheck": "tsc --noEmit",
    "test": "cd dev && supabase db reset && supabase test db",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build:sql && node scripts/stage-dev-db.mjs",
    "release": "npm publish"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": ">=14",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@supabase/ssr": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "supabase",
    "saml",
    "sso",
    "rls",
    "shibboleth",
    "postgres"
  ]
}
